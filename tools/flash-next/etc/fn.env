# Flash-Next build: every tunable and every pinned input in one file.
# Change cluster details here; nothing under bin/ hardcodes them.
#
# Serve-time settings (max seqs, KV dtype, speculation, ...) are NOT here: the
# production profile etc/models/qwen38-flash-next.env owns them. This file covers
# only what it takes to produce the artifacts that profile loads.

# ---- where it runs -----------------------------------------------------------
FN_NODE=${FN_NODE:-globus3}          # compute node that owns the model
# globus3 because that is where the production endpoint lives (weights on its local
# NVMe; the inter-node link is 1 GbE). The 27B weights stay at /scratch/models so a
# rollback is a profile switch, not a re-download.
FN_PARTITION=${FN_PARTITION:-backfill}

# ---- where things live (node-local scratch; safe to wipe) --------------------
FN_ROOT=${FN_ROOT:-$FN_HOME}         # this directory; logs/ and the patch clone land here
FN_SCRATCH=${FN_SCRATCH:-/scratch/fn2}
FN_HF=${FN_HF:-/scratch/hf}
FN_IMG=$FN_SCRATCH/img
FN_SP=$FN_IMG/usr/local/lib/python3.12/dist-packages
FN_KDET=$FN_SCRATCH/kernel-det
FN_LOGS=$FN_ROOT/logs

# ---- pinned inputs (the whole point: reproducible) ---------------------------
# Official vLLM image carrying Flash-Next support, pinned by digest.
FN_IMAGE_REPO=${FN_IMAGE_REPO:-vllm/vllm-openai}
FN_IMAGE_ARM64=${FN_IMAGE_ARM64:-sha256:3b0e188ffceb3d07e09c3cb5215433a0020eacf02d7f882ed3a8bfd15454477e}
# Patch stack, from the recipe this is ported from.
FN_PATCH_REPO=${FN_PATCH_REPO:-https://github.com/blazux/qwen3.8-Flash-DGX.git}
FN_PATCH_REF=${FN_PATCH_REF:-4b723de}
# Deterministic top-k kernel sources.
FN_KDET_SHA=${FN_KDET_SHA:-20f64c4c2fd7a5c37b420fc2dd3c47aa31fdad91}
FN_KDET_URL=https://raw.githubusercontent.com/jschmied/qwen38-flash-next-gb10/$FN_KDET_SHA
FN_DET_ARCH=${FN_DET_ARCH:-121a}     # sm_121a = GB10. RTX 5090 would be 120a.
# Checkpoint.
FN_MODEL=${FN_MODEL:-RadixArk/Qwen3.8-Flash-Next-NVFP4}
FN_MODEL_PKG=${FN_MODEL_PKG:-qwen3_8_flash_next}   # renamed to qwen4_exp on vLLM main
FN_MODE=${FN_MODE:-hybrid}           # hybrid | nvfp4 -- must match the profile's FN_MODE
