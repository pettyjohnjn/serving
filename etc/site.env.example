# Site-specific names. Copy to etc/site.env (git-ignored) and fill in.
# COMPUTE_NODE: slurm node that runs the model job
# LOGIN_FQDN:   public hostname users ssh to; substituted into the docs
#               copied to the shared mirror (replaces <login-node>)
COMPUTE_NODE=node1
LOGIN_FQDN=login.cluster.example.edu

# MODEL_PROFILE: which etc/models/<name>.env the endpoint serves.
#   qwen38-27b         Qwen3.8-27B NVFP4 (default; what has run since 2026-08)
#   qwen38-flash-next  Qwen3.8-Flash-Next, NVFP4 experts + fp8 dense path
# Changing this and running `serving restart` swaps the model. Rolling back is the
# same edit in reverse; both sets of weights can coexist on the node.
MODEL_PROFILE=qwen38-27b

# SERVED_NAME: optional. The name clients put in "model". Each profile has its own
# default (qwen3.8-27b, qwen3.8-flash-next). Pin one model-neutral name here if a
# profile swap must not break existing client configs; it applies to whichever
# profile is running, so do not pin one model's name and serve the other under it.
#SERVED_NAME=
