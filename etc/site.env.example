# Site configuration. Copy to etc/site.env (git-ignored), fill in, and keep it out of the repo: it names hosts,
# addresses and accounts. Every script sources it; nothing else in the repo hardcodes a site value.
# The account that runs `bin/serving` (normally a service account) owns every service and every file below.

# ---- login node ------------------------------------------------------------------------------------------
LOGIN_HOST=login                      # short hostname of the login node (where bin/serving runs)
LOGIN_FQDN=login.cluster.example.edu  # what users ssh to; substituted into the client docs
LOGIN_CLUSTER_IP=10.0.0.1             # login node on the cluster network (agent jobs reach fair-proxy here)

# ---- model engine (two GB10 nodes, tensor parallel over RoCE) ---------------------------------------------
ENGINE_NODES=nodeA,nodeB              # first = head (API, publishes the tunnel); both need the build (fn build)
ENGINE_PARTITION=main
ENGINE_HEAD_ADDR=10.0.1.15            # head node's address on the RoCE link (torch/NCCL rendezvous)
ENGINE_RDMA_IF=enp1s0f1np1            # netdev on that link (NCCL bootstrap, gloo, vLLM control plane)
ENGINE_RDMA_HCAS=rocep1s0f1,roceP2p1s0f1   # RoCE HCAs for NCCL data (both 200G links)
FN_SCRATCH=/scratch/models/fn         # node-local: extracted vLLM image + patches + det-topk kernel (fn build)
FN_HF=/scratch/models/hf              # node-local: checkpoint + -fp8hybrid-tp2 conversion (fn build)
# Engine settings (defaults are the validated production config; see DESIGN.md before changing):
#ENGINE_KV_BYTES=53687091200          # bf16 KV per GPU (50 GiB); the earlyoom ceiling is the limit
#ENGINE_SEQS=32
#SERVED_NAME=qwen3.8-flash-next

# ---- login-node services ----------------------------------------------------------------------------------
FAIR_TOTAL=32                         # = ENGINE_SEQS; fair-proxy admission slots
#FAIR_PER_USER=                       # unset: one user may take every free slot (newcomers get priority)
KEYED_PORT=8001                       # fair-proxy keyed listener on LOGIN_CLUSTER_IP (agent jobs, Bearer keys)
WEBUI_VENV=/shared/serving/venv-webui # x86 Open WebUI env (bin/install-webui-env.sh); keep off small root disks
WEBUI_NAME="Cluster Inference"
UV_CACHE_DIR=/shared/serving/uv-cache

# ---- agent workbench --------------------------------------------------------------------------------------
AGENT_NODES_EXCLUDE=nodeA,nodeB       # agent host jobs never land on the engine nodes
AGENT_PARTITION=main
AGENT_DEFAULT_CPUS=4
AGENT_DEFAULT_MEM=16G
AGENT_TOOLS=/shared/serving/agent-tools   # aarch64 Node + Pi + ttyd (bin/install-agent-tools.sh), world-readable
AGENT_PI_PACKAGES="git:github.com/GusEllerm/pi-lab-profile npm:@tintinweb/pi-subagents"
AGENT_PI_PROFILE=lab                  # pi-lab-profile scripts/install.sh profile, run once per agent account
AGENT_CLUSTER_IF=enP7s7               # compute-node netdev on the cluster network (ttyd binds here)
CONTROL_PORT=8092                     # dashboard control API on LOGIN_CLUSTER_IP (agent host jobs report here)
# Which account an agent runs as, for a person logged in as <user>:
#   same   -> <user>                  (agents run with the person's own permissions)
#   suffix -> <user><RUNAS_SUFFIX>    (a twin agent account per person, e.g. alice -> alice-agent)
#   map    -> looked up in RUNAS_MAP  (lines "user runas"); unknown users are refused
RUNAS_MODE=same
#RUNAS_SUFFIX=-agent
#RUNAS_MAP=/path/to/runas.map
# How the dashboard submits a host job as that account:
#   sbatch     -> plain sbatch; only allowed when the run-as account IS the service account (testing)
#   sudo       -> sudo -n -u <runas> sbatch ...; needs a sudoers rule limited to that command
#   slurmrestd -> REST submit with X-SLURM-USER-NAME/TOKEN; SLURM_TOKEN_CMD prints a JWT for {user}
SUBMIT_MODE=sbatch
#SLURMRESTD_URL=http://localhost:6820
#SLURMRESTD_API=v0.0.41
#SLURM_TOKEN_CMD="scontrol token username={user} lifespan=600"
