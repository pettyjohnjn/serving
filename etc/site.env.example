# Site-specific names. Copy to etc/site.env (git-ignored) and fill in.
# COMPUTE_NODE: slurm node that runs the model job
# LOGIN_FQDN:   public hostname users ssh to; substituted into the docs
#               copied to the shared mirror (replaces <login-node>)
COMPUTE_NODE=node1
LOGIN_FQDN=login.cluster.example.edu
