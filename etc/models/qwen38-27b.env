# Profile: Qwen3.8-27B NVFP4 — the endpoint as it has run since 2026-08.
# These are exactly the values serve.sh used before profiles existed; selecting
# this profile (the default) must not change behaviour in any way.

# Scheduler knobs. Read by bin/serving BEFORE submission (it greps only these two
# assignments), because #SBATCH directives are static and cannot vary per profile.
# These reproduce serve.sh's own #SBATCH values, so nothing changes for the 27B.
PROFILE_SBATCH=(--mem=96G --cpus-per-task=18)
PROFILE_COLDSTART=720          # seconds the supervisor allows for a cold boot

SERVED_NAME=${SERVED_NAME:-qwen3.8-27b}
MODEL=${MODEL:-/scratch/models/Qwen3.8-27B-NVFP4}

# Runtime: the repo's own venv, vLLM 0.27.1. `vllm serve <model>` takes the model
# positionally.
VLLM_LAUNCH=("$SERVING_ROOT/venv2/bin/vllm" serve)
MODEL_PASS=positional
VLLM_PATH_PREPEND="$SERVING_ROOT/venv2/bin"

MAX_MODEL_LEN=${MAX_MODEL_LEN:-262144}
MAX_SEQS=${MAX_SEQS:-32}
MAX_BATCHED_TOKENS=${MAX_BATCHED_TOKENS:-2048}
GPU_UTIL=${GPU_UTIL:-0.80}
SPEC_METHOD=${SPEC_METHOD:-qwen3_5_mtp}
SPEC_TOKENS=${SPEC_TOKENS:-3}
KV_DTYPE=${KV_DTYPE:-fp8}
KV_CACHE_BYTES=${KV_CACHE_BYTES:-76235669504}
REASONING_EFFORT=${REASONING_EFFORT:-medium}

profile_args () {
  PROFILE_ARGS=(
    --kv-cache-memory "$KV_CACHE_BYTES"
    --kv-cache-dtype "$KV_DTYPE"
    --async-scheduling
    --tool-call-parser qwen3_xml
    --default-chat-template-kwargs "{\"reasoning_effort\":\"$REASONING_EFFORT\"}"
    --limit-mm-per-prompt '{"image":4,"video":0}'
  )
}
profile_env () { :; }   # nothing beyond serve.sh's shared exports
