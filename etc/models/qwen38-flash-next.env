# Profile: Qwen3.8-Flash-Next, NVFP4 experts + blockwise-fp8 dense layers.
#
# Differs from the 27B in three structural ways, which is why profiles exist:
#   1. Runtime is not a pip venv. Flash-Next support only ships in the official
#      `vllm/vllm-openai:qwen38-flash-next` image; vLLM main renamed the model
#      package and changed the API the PLE patch hooks. The image is extracted to
#      local scratch and run with the host interpreter (see tools/flash-next/README.md).
#   2. The 47.7 GiB n-gram table is memory-mapped from NVMe, so it needs the PLE
#      env below or the model does not fit in 122 GiB.
#   3. The table lookup is a CPU op and MUST stay outside CUDA graphs, hence
#      PIECEWISE capture with an explicit splitting-op list.
#
# Build and verify the tree first:  tools/flash-next/bin/fn build && fn verify

# --mem=0 (whole node), NOT the 27B's 96G. This model reads a 126 GB checkpoint, and
# every byte read from disk is charged to the job's own cgroup as page cache. Against
# a 96 GB cap the job starves itself: it evicts pages it is about to need and thrashes
# while the node still has free memory. See 03a Memory Guard. The 27B never hits this
# because its weights are 22 GB.
PROFILE_SBATCH=(--mem=0 --cpus-per-task=20)
# Boot is ~700-800 s (NVFP4 shard processing), which straddles the 27B's 720 s grace.
# At 720 s the supervisor would judge a healthy cold boot "unhealthy" and restart it,
# forever. 1200 s leaves real headroom.
PROFILE_COLDSTART=1200

SERVED_NAME=${SERVED_NAME:-qwen3.8-flash-next}
FN_SCRATCH=${FN_SCRATCH:-/scratch/fn2}
FN_SP=$FN_SCRATCH/img/usr/local/lib/python3.12/dist-packages
FN_HF=${FN_HF:-/scratch/hf}
FN_HF_REPO=${FN_HF_REPO:-RadixArk/Qwen3.8-Flash-Next-NVFP4}
FN_MODEL_PKG=${FN_MODEL_PKG:-qwen3_8_flash_next}
FN_MODE=${FN_MODE:-hybrid}

_fn_base=$(ls -d "$FN_HF/hub/models--${FN_HF_REPO//\//--}"/snapshots/*/ 2>/dev/null \
           | grep -v -- '-fp8hybrid' | head -1); _fn_base=${_fn_base%/}
if [ -z "${MODEL:-}" ]; then
    # Resolve from the local cache, and refuse rather than hand serve.sh a path that
    # does not exist -- an empty MODEL would fall through to the 27B default below,
    # and a bare "-fp8hybrid" would fail deep inside the engine instead of here.
    [ -n "$_fn_base" ] || { echo "flash-next: no snapshot under $FN_HF for $FN_HF_REPO (run: tools/flash-next/bin/fn build)" >&2; return 1 2>/dev/null || exit 1; }
    MODEL=$( [ "$FN_MODE" = hybrid ] && echo "${_fn_base}-fp8hybrid" || echo "$_fn_base" )
fi
[ -d "$MODEL" ] || { echo "flash-next: model path does not exist: $MODEL" >&2; return 1 2>/dev/null || exit 1; }
if [ "$FN_MODE" = hybrid ] && [ ! -f "$MODEL/.prepared" ]; then
    echo "flash-next: hybrid checkpoint not prepared: $MODEL (run: tools/flash-next/bin/fn build)" >&2
    return 1 2>/dev/null || exit 1
fi

# Runtime: host python3.12 against the extracted image tree. The api_server module
# takes the model as a --model flag, not positionally.
VLLM_LAUNCH=(python3.12 -m vllm.entrypoints.openai.api_server)
MODEL_PASS=flag
VLLM_PATH_PREPEND=""

MAX_MODEL_LEN=${MAX_MODEL_LEN:-262144}
# 8, not the 27B's 32. This model degrades faster under concurrency (measured
# crossover ~4 streams), and the box is normally 1-4 users.
MAX_SEQS=${MAX_SEQS:-8}
MAX_BATCHED_TOKENS=${MAX_BATCHED_TOKENS:-8192}
# 0.80, not 0.85. vLLM still gates STARTUP on free >= total * gpu_memory_utilization
# using host-wide /proc/meminfo, which cannot see the slurm cgroup. 0.85 demands 103 of
# 122 GiB free and fails whenever a previous job is still releasing memory.
GPU_UTIL=${GPU_UTIL:-0.80}
# Pinned, like the 27B: identical across every requeue and it skips the profiling pass.
# 26 GiB ~= the 694k-token pool measured at bf16 on 2026-09-08, sized to sit inside
# the ~46 GiB left after ~76 GiB of resident weights.
KV_CACHE_BYTES=${KV_CACHE_BYTES:-27917287424}
# 1, not 3. Measured 2026-09-04: mtp=1 beats 2 and 3 at EVERY concurrency tested.
# Deeper speculation costs more than it returns on this architecture.
SPEC_METHOD=${SPEC_METHOD:-mtp}
SPEC_TOKENS=${SPEC_TOKENS:-1}
# auto = bf16. fp8_e4m3 gives ~1.9x the KV pool but its quality cost on the sparse
# attention path is unmeasured; do not switch without running the quality harness.
KV_DTYPE=${KV_DTYPE:-auto}
LOAD_FORMAT=${LOAD_FORMAT:-safetensors}
DET_TOPK=${DET_TOPK:-1}
# Matches the 27B. NOTE: this model rejects reasoning_effort="default" with HTTP 400;
# "none" and "low" are verified. Confirm "medium" before cutover -- serve.sh sends it
# as the server-side default and bin/smoke.py exercises "low" only.
REASONING_EFFORT=${REASONING_EFFORT:-medium}

_FN_SPLIT="[\"vllm::unified_attention_with_output\",\"vllm::unified_mla_attention_with_output\",\"vllm::mamba_mixer2\",\"vllm::mamba_mixer\",\"vllm::short_conv\",\"vllm::${FN_MODEL_PKG}_ple_short_conv\",\"vllm::${FN_MODEL_PKG}_qsa_with_output\",\"vllm::linear_attention\",\"vllm::qwen_gdn_attention_core\",\"vllm::qwen_gdn_attention_core_fused_norm_packed\",\"vllm::sparse_attn_indexer\",\"vllm::ple_mmap_lookup\"]"

profile_args () {
  PROFILE_ARGS=(
    --kv-cache-dtype "$KV_DTYPE"
    --kv-cache-memory "$KV_CACHE_BYTES"
    --load-format "$LOAD_FORMAT"
    --enable-chunked-prefill
    -cc.cudagraph_mode=PIECEWISE
    -cc.splitting_ops="$_FN_SPLIT"
    --no-enable-flashinfer-autotune
    --tool-call-parser qwen3_coder
    --limit-mm-per-prompt '{"image":4,"video":0}'
    --default-chat-template-kwargs "{\"reasoning_effort\":\"$REASONING_EFFORT\"}"
  )
}
profile_env () {
  export PYTHONPATH="$FN_SP" PYTHONNOUSERSITE=1
  export VLLM_PLE_MMAP=1 VLLM_PLE_MMAP_WORKERS=32
  export VLLM_USE_FLASHINFER_SAMPLER=1
  export VLLM_QSA_EXACT_TOPK=0
  [ "$FN_MODE" = hybrid ] && export VLLM_FP8_HYBRID=1 VLLM_USE_DEEP_GEMM=0
  [ "$DET_TOPK" = 1 ] && export VLLM_QSA_DET_TOPK=1 VLLM_QSA_DET_LIB=$FN_SCRATCH/kernel-det/_C_det.so
  export HF_HOME=$FN_HF HF_HUB_OFFLINE=1
  export VLLM_CACHE_ROOT="$FN_SCRATCH/.cache/vllm-$FN_MODE-mtp$SPEC_TOKENS-kv$KV_DTYPE-det$DET_TOPK"
  # Prevents the cgroup page-cache starvation failure (does NOT speed up boot).
  echo "[$(date)] prewarm: resident weight set"
  find -L "$MODEL" -maxdepth 1 \( -name 'layer-*.safetensors' -o -name 'model-bf16-*.safetensors' \) \
    ! -name '*.bak' -print0 2>/dev/null | xargs -0 -P 4 -n 1 cat > /dev/null 2>/dev/null
}
