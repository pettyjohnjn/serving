#!/usr/bin/env bash
# serving — single entrypoint for the inference endpoint and its login-node services. Run as the service account
# on the login node.
#
#   serving start          submit the engine job (two nodes, tensor parallel); refuses if one is already up
#   serving stop           drain in-flight requests, then stop; supervision pauses until the next start
#   serving restart        stop, wait for memory to be released, start
#   serving status         job state, reachability, live load, login-node services
#   serving logs [-f|N]    show (or follow) the current engine job's log
#   serving test           smoke-test the running endpoint
#   serving keys           list | add <user> | show <user> | revoke <user>   (API keys for the keyed listener)
#   serving doctor         diagnose a broken or unreachable endpoint
#   serving supervise      cron: keep the login services up, resubmit the engine if it should run and does not
#   serving install        one-time: authorize the tunnel key, install the cron line, start the services
#   serving uninstall      reverse of install, plus stop the engine: frees every port for another account
#   serving services start|stop|restart|status [fair-proxy|webui|dashboard|all]
#
# Login-node services (as this account): fair-proxy on 127.0.0.1:8000 (users by account) and
# $LOGIN_CLUSTER_IP:$KEYED_PORT (users by API key; agent jobs); Open WebUI + the identity proxy (bin/webui) on
# 127.0.0.1:8080 and the agent dashboard behind it on 127.0.0.1:8090. The engine publishes to 127.0.0.1:8005.
set -uo pipefail

ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
[ -f "$ROOT/etc/site.env" ] || { echo "serving: missing $ROOT/etc/site.env (copy etc/site.env.example)" >&2; exit 1; }
. "$ROOT/etc/site.env"
JOB=qwen38-serve
PORT=8000
COLDSTART=1200                 # boot is ~10 min (weights + graph capture on both nodes); supervise waits this long
SBATCH_ARGS=(-J "$JOB" -p "$ENGINE_PARTITION" -N2 -w "$ENGINE_NODES" -o "$ROOT/logs/serve-%j.out"
             -e "$ROOT/logs/serve-%j.out" --export=ALL,SERVING_ROOT="$ROOT")
SERVE=$ROOT/jobs/serve.sbatch
KEYS=$ROOT/state/keys.json
EP=$ROOT/etc/endpoint.json
SHARED_MIRROR=${SHARED_MIRROR:-/shared/llm}
served_model () { sed -n 's/.*"model": *"\([^"]*\)".*/\1/p' "$EP" 2>/dev/null | head -1 | grep . || echo '(see /v1/models)'; }
KEEP_LOGS=${KEEP_LOGS:-15}
DRAIN_WAIT=${DRAIN_WAIT:-180}

c_red=$'\033[31m'; c_grn=$'\033[32m'; c_yel=$'\033[33m'; c_dim=$'\033[2m'; c_off=$'\033[0m'
die()  { printf '%serror:%s %s\n' "$c_red" "$c_off" "$*" >&2; exit 1; }
info() { printf '%s\n' "$*"; }
warn() { printf '%swarn:%s %s\n' "$c_yel" "$c_off" "$*"; }
umask 077
mkdir -p "$ROOT/logs" "$ROOT/state"
[ -s "$KEYS" ] || echo '{}' > "$KEYS"

# cron does NOT reliably export USER; never depend on $USER here.
ME=$(id -un)
# Prefer a RUNNING job when several exist, so a queued duplicate can never mask the live one.
job_line()  { squeue -h -u "$ME" -n "$JOB" -o '%T %i %N' 2>/dev/null | sort -r | head -1; }
job_ids()   { squeue -h -u "$ME" -n "$JOB" -o '%i' 2>/dev/null; }
job_state() { job_line | awk '{print $1}'; }
job_id()    { job_line | awk '{print $2}'; }
job_node()  { job_line | awk '{print $3}'; }

# One lock for ALL lifecycle operations: otherwise cron can submit a job while a human is mid-restart.
LOCK="$ROOT/logs/.serving.lock"
take_lock() {  # $1 = "wait" | "nowait"; fails closed
    exec 9>"$LOCK" 2>/dev/null || { echo "cannot open $LOCK -- refusing to proceed" >&2; return 1; }
    if [ "${1:-wait}" = "nowait" ]; then flock -n 9 2>/dev/null || return 1
    else flock -w 600 9 2>/dev/null || return 1; fi
}
cur_log() { local j; j=$(job_id); [ -n "$j" ] && echo "$ROOT/logs/serve-$j.out"; }
health()  { curl -s -m 8 -o /dev/null -w '%{http_code}' "http://127.0.0.1:$PORT/health" 2>/dev/null; }

rotate_logs() {
    ls -1t "$ROOT"/logs/serve-*.out 2>/dev/null | tail -n +$((KEEP_LOGS + 1)) | while read -r f; do rm -f "$f"; done
}
wait_ready() {   # $1 = timeout seconds
    local t=${1:-1500} i=0 log; log=$(cur_log)
    printf 'waiting for the model to load '
    while [ "$i" -lt "$t" ]; do
        [ "$(health)" = "200" ] && { printf ' %sready%s\n' "$c_grn" "$c_off"; return 0; }
        [ -z "$(job_state)" ] && { printf ' %sjob exited%s\n' "$c_red" "$c_off"; [ -n "$log" ] && tail -5 "$log"; return 1; }
        printf '.'; sleep 10; i=$((i + 10))
    done
    printf ' %stimed out%s\n' "$c_red" "$c_off"; return 1
}

# Prove the flags that make the endpoint safe reach vLLM: a truncated ARGS array once launched vLLM without
# --host, which exposed the port publicly. bash -n cannot catch it.
lint_serve_script() {
    python3 - "$SERVE" <<'PYEOF'
import re, sys
lines = open(sys.argv[1]).read().split("\n")
try:
    start = next(i for i, l in enumerate(lines) if l.strip().startswith("local ARGS=("))
except StopIteration:
    sys.exit("lint: could not find the ARGS assembly in serve.sbatch")
flags = set(); depth = 0
for l in lines[start:]:
    code = l.split("#", 1)[0] if l.strip().startswith("#") else l
    depth += code.count("(") - code.count(")")
    flags.update(re.findall(r"--[a-z0-9-]+", code))
    if depth <= 0:
        break
for required in ("--served-model-name", "--enable-prefix-caching", "--speculative-config",
                 "--allowed-media-domains", "--disable-fastapi-docs", "--allowed-origins"):
    if required not in flags:
        sys.exit(f"lint: {required} never reaches vllm (array truncated?)")
text = "\n".join(lines)
if not re.search(r'ARGS\+=\(--host 127\.0\.0\.1 --port', text):
    sys.exit("lint: the head node no longer binds 127.0.0.1")
if not re.search(r'serve "\$\{ARGS\[@\]\}"', text):
    sys.exit("lint: ARGS is assembled but never executed")
for env in ("VLLM_NO_USAGE_STATS=1", "VLLM_DO_NOT_TRACK=1", "VLLM_MEDIA_URL_ALLOW_REDIRECTS=0"):
    if env not in text:
        sys.exit(f"lint: {env} missing (telemetry / media redirects)")
if "0.0.0.0" in re.sub(r"#.*", "", text):
    sys.exit("lint: 0.0.0.0 appears in serve.sbatch")
PYEOF
}

# ---------------------------------------------------------------- login-node services
pat () { case $1 in fair-proxy) echo "[f]air-proxy.py";; dashboard) echo "[w]orkbench/dashboard.py";; esac; }
# capture first: with pipefail, grep -q exiting early makes the producer die of SIGPIPE and the test fail
svc_running () { case $1 in webui) local o; o=$("$ROOT/bin/webui" status 2>/dev/null); grep -q "^backend  running" <<<"$o" ;;
                 *) pgrep -u "$ME" -f "$(pat "$1")" >/dev/null ;; esac; }
svc_start () {
    case $1 in
      fair-proxy)
        svc_running fair-proxy && return 0
        FAIR_LISTEN=$PORT FAIR_UPSTREAM=8005 FAIR_TOTAL=${FAIR_TOTAL:-32} FAIR_PER_USER=${FAIR_PER_USER:-0} \
        FAIR_KEYED_LISTEN="$LOGIN_CLUSTER_IP:$KEYED_PORT" FAIR_KEYS_FILE="$KEYS" \
          nohup python3 "$ROOT/bin/fair-proxy.py" >> "$ROOT/logs/fair-proxy.log" 2>&1 &
        echo "[$(date -Is)] started fair-proxy" >> "$ROOT/logs/supervise.log" ;;
      webui) "$ROOT/bin/webui" ensure ;;
      dashboard)
        svc_running dashboard && return 0
        nohup "$WEBUI_VENV/bin/python" "$ROOT/workbench/dashboard.py" >> "$ROOT/logs/dashboard.log" 2>&1 &
        echo "[$(date -Is)] started dashboard" >> "$ROOT/logs/supervise.log" ;;
    esac
}
svc_stop () {
    case $1 in webui) "$ROOT/bin/webui" stop ;;
               *) pkill -u "$ME" -f "$(pat "$1")" && info "stopped $1" ;; esac
}
svc_list () { case ${1:-all} in all) echo fair-proxy webui dashboard ;; fair-proxy|webui|dashboard) echo "$1" ;;
              *) die "unknown service '$1' (fair-proxy|webui|dashboard|all)" ;; esac; }
cmd_services () {
    local action=${1:-status} s; shift || true
    case $action in
      start)   for s in $(svc_list "${1:-all}"); do svc_start "$s"; done ;;
      stop)    for s in $(svc_list "${1:-all}"); do svc_stop "$s"; done ;;
      restart) for s in $(svc_list "${1:-all}"); do svc_stop "$s"; sleep 1; svc_start "$s"; done ;;
      status)  for s in $(svc_list "${1:-all}"); do
                 svc_running "$s" && printf '  %-11s %srunning%s\n' "$s" "$c_grn" "$c_off" \
                                  || printf '  %-11s %sNOT RUNNING%s\n' "$s" "$c_red" "$c_off"; done ;;
      *) die "usage: serving services start|stop|restart|status [fair-proxy|webui|dashboard|all]" ;;
    esac
}

# ---------------------------------------------------------------- engine lifecycle
cmd_start() {
    take_lock wait || die "another serving operation is in progress"
    rm -f "$ROOT/logs/.paused"
    lint_serve_script || die "refusing to start: serve.sbatch would launch vllm without its safety flags"
    local st; st=$(job_state)
    [ -n "$st" ] && { info "already $st as job $(job_id) on $(job_node); use 'serving restart' to replace it"; return 0; }
    rotate_logs
    local out; out=$(cd "$ROOT" && sbatch "${SBATCH_ARGS[@]}" "$SERVE" 2>&1) || die "$out"
    info "$out"
    wait_ready $((COLDSTART + 300)) && cmd_status
}

cmd_stop() {
    take_lock wait || die "another serving operation is in progress"
    touch "$ROOT/logs/.paused"          # 'stop' must mean stopped: otherwise cron resurrects it within 5 minutes
    local ids j st; ids=$(job_ids)
    [ -z "$ids" ] && { info "not running (supervision paused; 'serving start' resumes it)"; return 0; }
    for j in $ids; do
        st=$(squeue -h -j "$j" -o '%T' 2>/dev/null)
        if [ "$st" = "RUNNING" ]; then info "draining job $j (in-flight requests get up to 120 s)..."
             scancel --signal=TERM --batch "$j" 2>/dev/null
        else info "cancelling queued job $j"; scancel "$j" 2>/dev/null; fi
    done
    local i=0
    while [ "$i" -lt "$DRAIN_WAIT" ]; do
        [ -z "$(job_ids)" ] && { info "stopped; supervision paused."; return 0; }
        sleep 5; i=$((i + 5))
    done
    warn "still up after ${DRAIN_WAIT}s; forcing"
    for j in $(job_ids); do scancel "$j" 2>/dev/null; done
    sleep 5; info "stopped; supervision paused."
}

cmd_restart() {
    take_lock wait || die "another serving operation is in progress"
    cmd_stop
    # The engine releases ~90 GiB per node back to the unified pool asynchronously; let it settle.
    printf 'waiting for memory to be released '
    local i=0
    while [ "$i" -lt 90 ]; do printf '.'; sleep 5; i=$((i + 5)); [ -z "$(job_state)" ] && [ "$i" -ge 20 ] && break; done
    printf ' done\n'
    cmd_start
}

fair_stats_line () {
    curl -s -m 5 "http://127.0.0.1:$PORT/fair-stats" 2>/dev/null | python3 -c "$(cat <<'PYEOF'
import json, sys
d = json.load(sys.stdin)
print(f"{sum(d['in_flight'].values())}/{d['total_slots']} slots in use, by user {d['in_flight']}, queued {d['queued']}")
PYEOF
)" 2>/dev/null
}

cmd_status() {
    [ -f "$ROOT/logs/STATUS" ] && { printf '\n%s*** SUPERVISION HAS GIVEN UP ***%s\n' "$c_red" "$c_off"; sed 's/^/  /' "$ROOT/logs/STATUS"; }
    [ -f "$ROOT/logs/.paused" ] && printf '\n%ssupervision paused%s (serving stop); serving start resumes it\n' "$c_yel" "$c_off"
    local st node j code
    st=$(job_state); j=$(job_id); node=$(job_node)
    printf '\n%s=== engine job ===%s\n' "$c_dim" "$c_off"
    if [ -z "$st" ]; then printf '  %sNOT RUNNING%s   (serving start)\n' "$c_red" "$c_off"
    else printf '  %s%s%s  job %s on %s  (elapsed %s)\n' "$c_grn" "$st" "$c_off" "$j" "$node" \
             "$(squeue -h -j "$j" -o '%M' 2>/dev/null)"; fi
    printf '\n%s=== reachability (this host) ===%s\n' "$c_dim" "$c_off"
    code=$(health)
    if [ "$code" = "200" ]; then printf '  /health              %s200%s  model %s\n' "$c_grn" "$c_off" "$(served_model)"
    else printf '  /health              %s%s%s  (endpoint not answering)\n' "$c_red" "${code:-000}" "$c_off"; fi
    printf '  keyed listener       %s without a key (401 expected)\n' \
        "$(curl -s -m 5 -o /dev/null -w '%{http_code}' "http://$LOGIN_CLUSTER_IP:$KEYED_PORT/v1/models")"
    if [ "$code" = "200" ]; then
        printf '\n%s=== live load ===%s\n' "$c_dim" "$c_off"
        curl -s -m 8 "http://127.0.0.1:8005/metrics" 2>/dev/null | awk '
          /^vllm:num_requests_running\{/      {printf "  in flight            %d\n", $2}
          /^vllm:num_requests_waiting\{/      {printf "  queued in engine     %d\n", $2}
          /^vllm:kv_cache_usage_perc\{/       {printf "  kv cache used        %.1f%%\n", $2*100}
          /^vllm:prefix_cache_queries_total\{/{q=$2}
          /^vllm:prefix_cache_hits_total\{/   {h=$2}
          /^vllm:num_preemptions_total\{/     {p=$2}
          END { if (q>0) printf "  prefix cache hits    %.1f%% of queried tokens\n", 100*h/q
                printf "  preemptions          %d since boot\n", p }'
        printf '  fair-proxy           %s\n' "$(fair_stats_line)"
    else
        printf '\nrun %sserving doctor%s for a diagnosis\n' "$c_yel" "$c_off"
    fi
    printf '\n%s=== login-node services ===%s\n' "$c_dim" "$c_off"
    cmd_services status
    printf '  agent host jobs      %s\n' "$(squeue -h -o '%u %j' 2>/dev/null | awk '$2 ~ /^agent-host-/' | wc -l)"
    printf '\n%s=== clients ===%s\n' "$c_dim" "$c_off"
    printf '  tunnel   ssh -N -L 8000:127.0.0.1:8000 -L 8080:127.0.0.1:8080 -L 8090:127.0.0.1:8090 %s\n' "${LOGIN_FQDN:-<login-node>}"
    printf '  api      http://localhost:8000/v1   model %s\n' "$(served_model)"
    printf '  browser  http://localhost:8080 (chat)   http://localhost:8090 (agents)\n\n'
    [ "$code" = "200" ]
}

cmd_logs() {
    local log; log=$(cur_log)
    [ -z "$log" ] && log=$(ls -1t "$ROOT"/logs/serve-*.out 2>/dev/null | head -1)
    [ -z "$log" ] && die "no logs yet"
    if [ "${1:-}" = "-f" ]; then tail -f "$log"; else tail -n "${1:-60}" "$log"; fi
}

cmd_test() {
    [ "$(health)" = "200" ] || die "endpoint not answering; try 'serving doctor'"
    "$WEBUI_VENV/bin/python" "$ROOT/bin/smoke.py" "http://127.0.0.1:$PORT/v1"
}

cmd_keys() {
    python3 - "$KEYS" "${1:-list}" "${2:-}" <<'PYEOF'
import json, os, secrets, sys
path, action, user = sys.argv[1], sys.argv[2], sys.argv[3]
keys = json.load(open(path))
def save():
    tmp = path + ".tmp"
    with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f: json.dump(keys, f, indent=1)
    os.replace(tmp, path)
by_user = {u: k for k, u in keys.items()}
if action == "list":
    for u in sorted(by_user): print(f"{u:16} {by_user[u][:12]}...")
elif action in ("add", "show"):
    if not user: sys.exit("usage: serving keys add|show <user>")
    if user not in by_user:
        if action == "show": sys.exit(f"no key for {user}")
        k = "sk-spark-" + secrets.token_urlsafe(24); keys[k] = user; save(); by_user[user] = k
    print(by_user[user])
elif action == "revoke":
    if user not in by_user: sys.exit(f"no key for {user}")
    del keys[by_user[user]]; save(); print(f"revoked {user} (fair-proxy re-reads the file; no restart)")
else:
    sys.exit("usage: serving keys list | add <user> | show <user> | revoke <user>")
PYEOF
}

cmd_doctor() {
    [ -f "$ROOT/logs/STATUS" ] && { printf '\n%s*** SUPERVISION HAS GIVEN UP ***%s\n' "$c_red" "$c_off"; sed 's/^/  /' "$ROOT/logs/STATUS"; }
    printf '\n%s=== diagnosis ===%s\n' "$c_dim" "$c_off"
    local st log; st=$(job_state); log=$(cur_log)
    if [ -z "$st" ]; then
        printf '  %sno engine job%s\n' "$c_red" "$c_off"
        local last; last=$(ls -1t "$ROOT"/logs/serve-*.out 2>/dev/null | head -1)
        if [ -n "$last" ]; then
            printf '  last job log: %s\n' "$last"
            local why; why=$(grep -oE 'CUDA out of memory|checkpoint not prepared[^"]*|no completed conversion|Engine core initialization failed|KeyboardInterrupt|shutdown triggered|ncclInternalError|unhealthy 5x' "$last" | tail -1)
            [ -n "$why" ] && printf '  likely cause: %s%s%s\n' "$c_yel" "$why" "$c_off"
            grep -q 'KeyboardInterrupt\|shutdown triggered' "$last" 2>/dev/null && \
                printf '  (SIGTERM with no CUDA OOM = earlyoom on a node: lower ENGINE_KV_BYTES)\n'
        fi
        printf '  fix: serving start\n\n'; return 1
    fi
    printf '  job %s is %s on %s\n' "$(job_id)" "$st" "$(job_node)"
    [ "$st" != "RUNNING" ] && { printf '  waiting for slurm to schedule it\n\n'; return 1; }
    if [ -n "$log" ] && [ "$(health)" != "200" ]; then
        if ! tail -n 400 "$log" | grep -q 'Application startup complete'; then
            printf '  %sstill starting%s; last milestone:\n' "$c_yel" "$c_off"
            grep -E 'Model loading took|GPU KV cache size|Capturing|prewarm|launching vLLM' "$log" | tail -1 | sed 's/^/    /'
            printf '  cold start is ~10 min\n\n'; return 1
        fi
        printf '  %sjob is up but the endpoint is not reachable here%s\n' "$c_red" "$c_off"
        printf '    last publisher line: %s\n' "$(grep '\[publisher\]' "$log" | tail -1)"
        printf '    check the tunnel key (serving install) and: serving logs 40\n\n'; return 1
    fi
    printf '  %sengine healthy%s\n' "$c_grn" "$c_off"; cmd_services status; printf '\n'
}

# Backoff and a terminal give-up, so a broken deployment cannot loop on the nodes forever, and cannot look like
# "cron is handling it" while doing so.
SUPER_STATE="$ROOT/logs/.supervise.state"
SUPER_MAX=${SUPER_MAX:-5}
supervise_attempt() {
    local reason="$1" n=0 last=0 now wait_for; now=$(date +%s)
    [ -f "$SUPER_STATE" ] && read -r n last < "$SUPER_STATE" 2>/dev/null
    n=${n:-0}; last=${last:-0}
    if [ "$n" -ge "$SUPER_MAX" ]; then
        [ -f "$ROOT/logs/STATUS" ] || {
            printf 'BROKEN since %s\nafter %d consecutive failed recoveries: %s\nsupervision has GIVEN UP; fix, then run: serving start\n' \
                "$(date -Is)" "$n" "$reason" > "$ROOT/logs/STATUS"
            logger -t "$JOB" "GIVING UP after $n failed recoveries: $reason" 2>/dev/null
            echo "[$(date -Is)] GIVING UP after $n failures ($reason)" >> "$ROOT/logs/supervise.log"; }
        return 1
    fi
    wait_for=$(( 300 * (1 << n) )); [ "$wait_for" -gt 3600 ] && wait_for=3600
    [ "$last" -ne 0 ] && [ $((now - last)) -lt "$wait_for" ] && return 1
    printf '%d %d\n' "$((n + 1))" "$now" > "$SUPER_STATE"
    echo "[$(date -Is)] attempt $((n+1))/$SUPER_MAX ($reason)" >> "$ROOT/logs/supervise.log"
    return 0
}

cmd_supervise() {
    # Login services first, independent of the engine's pause/lock gates.
    local s; for s in fair-proxy webui dashboard; do svc_running "$s" || svc_start "$s" >/dev/null 2>&1; done
    if [ -d "$SHARED_MIRROR" ] && [ -n "${LOGIN_FQDN:-}" ]; then
        # The repo keeps <login-node> placeholders so it can be public; the mirror gets the real hostname.
        local f
        for f in QUICKSTART.md CLIENTS.md README.md bin/chat.py bin/llm-tunnel; do
            [ -f "$ROOT/$f" ] && sed "s|<login-node>|$LOGIN_FQDN|g" "$ROOT/$f" > "$SHARED_MIRROR/$(basename "$f")" 2>/dev/null
        done
        mkdir -p "$SHARED_MIRROR/examples"; cp -u "$ROOT"/examples/* "$SHARED_MIRROR/examples/" 2>/dev/null
        chmod a+rx "$SHARED_MIRROR/chat.py" "$SHARED_MIRROR/llm-tunnel" 2>/dev/null
        chmod -R a+rX,go-w "$SHARED_MIRROR" 2>/dev/null
    fi
    [ -f "$ROOT/logs/.paused" ] && exit 0
    take_lock nowait || exit 0
    squeue -h -u "$ME" -o '%i' >/dev/null 2>&1 || exit 0    # unreadable cluster state: never submit blind
    local st code; st=$(job_state); code=$(health)
    if [ -n "$st" ] && [ "$code" = "200" ]; then rm -f "$SUPER_STATE" "$ROOT/logs/STATUS"; exit 0; fi
    [ -n "$st" ] && [ "$st" != "RUNNING" ] && exit 0         # pending: leave it alone
    if [ -n "$st" ]; then
        # Elapsed time (reset by a requeue) is the honest boot signal; the log keeps last run's markers.
        local t secs; t=$(squeue -h -j "$(job_id)" -o '%M' 2>/dev/null)
        secs=$(awk -F'[-:]' '{n=NF; s=$n; if(n>1) s+=60*$(n-1); if(n>2) s+=3600*$(n-2); if(n>3) s+=86400*$(n-3); print s}' <<<"${t:-0:00}")
        [ "${secs:-0}" -lt "$COLDSTART" ] && exit 0
        supervise_attempt "unhealthy (http ${code:-000})" || exit 0
        cmd_restart >> "$ROOT/logs/supervise.log" 2>&1; exit 0
    fi
    supervise_attempt "no job present" || exit 0
    (cd "$ROOT" && sbatch "${SBATCH_ARGS[@]}" "$SERVE") >> "$ROOT/logs/supervise.log" 2>&1
}

# ---------------------------------------------------------------- one-time setup
cmd_install() {
    local key=$HOME/.ssh/id_llm_tunnel auth=$HOME/.ssh/authorized_keys label=llm-reverse-tunnel
    [ -f "$key" ] || ssh-keygen -q -t ed25519 -N '' -f "$key" -C "$label"
    touch "$auth"; chmod 600 "$auth"; cp "$auth" "$auth.bak.$(date +%s)"
    grep -v " $label\$" "$auth" > "$auth.tmp"; mv "$auth.tmp" "$auth"
    # The engine job's key may do exactly one thing: listen on the login node's 127.0.0.1:8005. restrict = no
    # shell/pty/agent/X11; permitopen 127.0.0.1:1 blocks -L; command=/bin/false because restrict alone allows it.
    printf 'restrict,port-forwarding,permitlisten="127.0.0.1:8005",permitopen="127.0.0.1:1",command="/bin/false" %s %s\n' \
        "$(awk '{print $1" "$2}' "$key.pub")" "$label" >> "$auth"
    chmod 600 "$auth"; info "tunnel key: may listen on 127.0.0.1:8005 only"
    local cron="*/5 * * * * $ROOT/bin/serving supervise >/dev/null 2>&1  # serving"
    ( crontab -l 2>/dev/null | grep -v '# serving$'; echo "$cron" ) | crontab -
    info "cron: $cron"
    cmd_services start
}

cmd_uninstall() {
    cmd_stop
    cmd_services stop
    ( crontab -l 2>/dev/null | grep -v '# serving$' ) | crontab -
    local auth=$HOME/.ssh/authorized_keys
    if [ -f "$auth" ]; then cp "$auth" "$auth.bak.$(date +%s)"; grep -v " llm-reverse-tunnel\$" "$auth" > "$auth.tmp"
        mv "$auth.tmp" "$auth"; chmod 600 "$auth"; fi
    info "uninstalled: engine stopped, services stopped, cron line and tunnel key line removed"
    info "(state/, webui-data/ and logs/ are kept; agent host jobs end on their own after 30 idle minutes)"
}

case "${1:-status}" in
    start)     shift; cmd_start ;;
    stop)      shift; cmd_stop ;;
    restart)   shift; cmd_restart ;;
    status|"") cmd_status ;;
    logs)      shift; cmd_logs "$@" ;;
    test)      shift; cmd_test ;;
    keys)      shift; cmd_keys "$@" ;;
    doctor)    shift; cmd_doctor ;;
    supervise) shift; cmd_supervise ;;
    install)   shift; cmd_install ;;
    uninstall) shift; cmd_uninstall ;;
    services)  shift; cmd_services "$@" ;;
    -h|--help|help) awk 'NR>1 && !/^#/ {exit} NR>1' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command '$1' (try: serving help)" ;;
esac
